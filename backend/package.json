{
  "name": "wheels-enchantment-backend",
  "version": "1.0.0",
  "description": "Backend API for Wheels Enchntment - Premium Skating Academy",
  "main": "dist/server.js",
  "scripts": {
    "dev": "nodemon --exec ts-node src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "start:prod": "pm2 start ecosystem.config.js --env production",
    "lint": "eslint . --ext .ts",
    "format": "prettier --write \"src/**/*.ts\"",
    "seed:admin": "ts-node src/seeds/admin.seed.ts",
    "seed:categories": "ts-node src/seeds/categories.seed.ts",
    "seed:locations": "ts-node src/seeds/locations.seed.ts",
    "seed:gallery": "ts-node src/seeds/gallery.seed.ts",
    "seed:hero": "ts-node src/seeds/heroSlides.seed.ts",
    "seed:reviews": "node src/seeds/seedReviews.js",
    "seed:backend-files": "ts-node src/seeds/backend-files.seed.ts",
    "seed:complete": "ts-node src/seeds/complete.seed.ts",
    "seed:all": "npm run seed:admin && npm run seed:categories && npm run seed:locations && npm run seed:complete && npm run seed:backend-files"
  },
  "keywords": ["skating", "academy", "api", "typescript", "express"],
  "author": "Wheels Enchntment",
  "license": "MIT",
  "dependencies": {
    "express": "^4.18.2",
    "mongoose": "^8.0.3",
    "redis": "^4.6.12",
    "dotenv": "^16.3.1",
    "cors": "^2.8.5",
    "helmet": "^7.1.0",
    "express-rate-limit": "^7.1.5",
    "express-mongo-sanitize": "^2.2.0",
    "hpp": "^0.2.3",
    "bcryptjs": "^2.4.3",
    "jsonwebtoken": "^9.0.2",
    "zod": "^3.22.4",
    "multer": "^1.4.5-lts.1",
    "sharp": "^0.33.1",
    "uuid": "^9.0.1",
    "winston": "^3.11.0",
    "winston-daily-rotate-file": "^4.7.1",
    "nodemailer": "^6.9.7",
    "slugify": "^1.6.6",
    "compression": "^1.7.4",
    "cookie-parser": "^1.4.6"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.10.6",
    "@types/cors": "^2.8.17",
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/multer": "^1.4.11",
    "@types/uuid": "^9.0.7",
    "@types/nodemailer": "^6.4.14",
    "@types/compression": "^1.7.5",
    "@types/cookie-parser": "^1.4.6",
    "@types/hpp": "^0.2.5",
    "typescript": "^5.3.3",
    "ts-node": "^10.9.2",
    "nodemon": "^3.0.2",
    "eslint": "^8.56.0",
    "@typescript-eslint/eslint-plugin": "^6.16.0",
    "@typescript-eslint/parser": "^6.16.0",
    "prettier": "^3.1.1"
  }
}
